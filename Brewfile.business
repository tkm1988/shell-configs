tap "homebrew/bundle"
tap "homebrew/services"
tap "launchdarkly/tap"
tap "microsoft/apm", trusted: true
tap "rbenv/tap", trusted: true
# Run your GitHub Actions locally
brew "act"
# GNU multiple precision arithmetic library
brew "gmp"
# Static checker for GitHub Actions workflow files
brew "actionlint"
# Spell checker with better logic than ispell
brew "aspell"
# Library for command-line editing
brew "readline"
# Automatic configure script builder
brew "autoconf"
# Official Amazon AWS command-line interface
brew "awscli"
# Cryptography and SSL/TLS Toolkit
brew "openssl@3"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# Core application library for C
brew "glib"
# YAML Parser
brew "libyaml"
# Tool to obtain certs from Let's Encrypt and autoenable HTTPS
brew "certbot"
# Diff that understands syntax
brew "difftastic"
# GNU Emacs text editor
brew "emacs"
# Simple, fast and user-friendly alternative to find
brew "fd"
# Play, record, convert, and stream select audio and video codecs
brew "ffmpeg"
# Command-line fuzzy finder written in Go
brew "fzf"
# GNU awk utility
brew "gawk"
# Postgres C API library
brew "libpq"
# GitHub command-line tool
brew "gh"
# Distributed revision control system
brew "git"
# GNU implementation of the famous stream editor
brew "gnu-sed"
# Framework for layout and rendering of i18n text
brew "pango"
# Graph visualization software from AT&T and Bell Labs
brew "graphviz"
# CLI for Heroku
brew "heroku"
# Lightweight and flexible command-line JSON processor
brew "jq"
# CLI for managing LaunchDarkly feature flags
brew "ldcli"
# Terminal Markdown previewer with a GUI-like experience
brew "leaf-markdown-viewer"
# Move files and folders to the trash
brew "macos-trash", link: true
# Polyglot runtime manager (asdf rust clone)
brew "mise"
# 7-Zip (high compression file archiver) implementation
brew "p7zip"
# Swiss-army knife of markup format conversion
brew "pandoc"
# PostgreSQL syntax beautifier
brew "pgformatter"
# Adds support for geographic objects to PostgreSQL
brew "postgis"
# Object-relational database system
brew "postgresql@14", restart_service: :changed
# Framework for managing multi-language pre-commit hooks
brew "pre-commit"
# Password generator
brew "pwgen"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Package Management Solution for Python
brew "rye"
# Fast, configurable, shell plugin manager
brew "sheldon"
# Editor of encrypted files
brew "sops"
# Cross-shell prompt for astronauts
brew "starship"
# Terraform version manager inspired by rbenv
brew "tfenv"
# Terminal multiplexer
brew "tmux"
# Display directories as trees (with optional color/HTML output)
brew "tree"
# Vulnerability scanner for container images, file systems, and Git repos
brew "trivy"
# Extremely fast Python package installer and resolver, written in Rust
brew "uv"
# Executes a program periodically, showing output fullscreen
brew "watch"
# Internet file retriever
brew "wget"
# Friendly and fast tool for sending HTTP requests
brew "xh"
# Agent Package Manager (APM): The NPM for AI-Native Development
brew "microsoft/apm/apm"
# Cryptography and SSL/TLS Toolkit
brew "rbenv/tap/openssl@1.1"
# View, print, and comment on PDF documents
cask "adobe-acrobat-reader"
# Application launcher and productivity software
cask "alfred"
# Japanese input method
cask "azookey"
# Terminal-based AI coding assistant
cask "claude-code"
# OpenAI's coding agent that runs in your terminal
cask "codex"
# Universal database tool and SQL client
cask "dbeaver-community"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Web browser
cask "firefox"
cask "font-google-sans-code"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Cross-platform Git credential storage for multiple hosting providers
cask "git-credential-manager"
# Web browser
cask "google-chrome"
# Client for the Google Drive storage service
cask "google-drive"
# Clipboard manager
cask "maccy"
# Zip archiver
cask "macwinzipper"
# Move and resize windows using keyboard shortcuts or snap areas
cask "rectangle"
# Team communication and collaboration software
cask "slack"
# CSV editor
cask "smoothcsv"
# Native GUI tool for relational databases
cask "tableplus"
# Lightweight database management tool
cask "tabularis"
# Open-source code editor
cask "visual-studio-code"
# Video communication and virtual meeting platform
cask "zoom"
